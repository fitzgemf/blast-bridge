            "$ref": "#/$defs/TempoSource"
          },
          "minItems": 1,
          "title": "Records",
          "type": "array"
        }
      },
      "required": [
        "metadata",
        "records"
      ],
      "title": "TempoSources",
      "type": "object"
    },
    "TempoTaxonomy": {
      "additionalProperties": false,
      "properties": {
        "metadata": {
          "$ref": "#/$defs/TempoMetadata"
        },
        "records": {
          "items": {
            "$ref": "#/$defs/CountingDefinition"
          },
          "maxItems": 8,
          "minItems": 8,
          "title": "Records",
          "type": "array"
        },
        "source_term_mappings": {
          "items": {
            "$ref": "#/$defs/TermMapping"
          },
          "minItems": 1,
          "title": "Source Term Mappings",
          "type": "array"
        },
        "evidence_types": {
          "items": {
            "$ref": "#/$defs/EvidenceType"
          },
          "title": "Evidence Types",
          "type": "array"
        },
        "representativeness_values": {
          "items": {
            "$ref": "#/$defs/Representativeness"
          },
          "title": "Representativeness Values",
          "type": "array"
        },
        "participation_roles": {
          "items": {
            "$ref": "#/$defs/ParticipationRole"
          },
          "title": "Participation Roles",
          "type": "array"
        },
        "components": {
          "items": {
            "$ref": "#/$defs/TempoComponent"
          },
          "title": "Components",
          "type": "array"
        }
      },
      "required": [
        "metadata",
        "records",
        "source_term_mappings",
        "evidence_types",
        "representativeness_values",
        "participation_roles",
        "components"
      ],
      "title": "TempoTaxonomy",
      "type": "object"
    },
    "TermMapping": {
      "additionalProperties": false,
      "properties": {
        "source_term": {
          "minLength": 1,
          "title": "Source Term",
          "type": "string"
        },
        "evidence_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$",
          "title": "Evidence Id",
          "type": "string"
        },
        "mapping": {
          "anyOf": [
            {
              "$ref": "#/$defs/CountingUnit"
            },
            {
              "type": "null"
            }
          ]
        },
        "ambiguity": {
          "minLength": 1,
          "title": "Ambiguity",
          "type": "string"
        }
      },
      "required": [
        "source_term",
        "evidence_id",
        "mapping",
        "ambiguity"
      ],
      "title": "TermMapping",
      "type": "object"
    },
    "TimeWindow": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "start_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Date"
        },
        "end_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Date"
        },
        "year": {
          "anyOf": [
